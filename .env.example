# ── Core ──────────────────────────────────────────────────────────────
# Local dev default is SQLite; compose overrides with Postgres.
DATABASE_URL=sqlite:///./dev.db
# Optional. When unset, an in-memory fallback is used for cache/rate limits.
REDIS_URL=
# eager = run tasks inline (no Redis needed, local dev); celery = real queue.
QUEUE_MODE=eager
# Global dry-run: publishers simulate success instead of calling live APIs.
DRY_RUN=true

# ── Generation providers (mock works with zero keys) ──────────────────
LLM_PROVIDER=mock            # mock | claude | openai | ollama
IMAGE_PROVIDER=mock          # mock | dalle | stable_diffusion
VIDEO_PROVIDER=mock          # mock | falai | kling

ANTHROPIC_API_KEY=
OPENAI_API_KEY=
OLLAMA_BASE_URL=http://localhost:11434
STABILITY_API_KEY=
FAL_KEY=
KLING_API_KEY=

# ── Security ──────────────────────────────────────────────────────────
# AES-256 key, base64url-encoded 32 bytes. Generate with:
#   python -c "from cryptography.fernet import Fernet; import base64,os; print(base64.urlsafe_b64encode(os.urandom(32)).decode())"
ENCRYPTION_KEY=

# ── Platform API credentials (optional; dry-run works without them) ───
META_APP_ID=
META_APP_SECRET=
LINKEDIN_CLIENT_ID=
LINKEDIN_CLIENT_SECRET=
YOUTUBE_CLIENT_ID=
YOUTUBE_CLIENT_SECRET=
TWITTER_CLIENT_ID=
TWITTER_CLIENT_SECRET=
TIKTOK_CLIENT_KEY=
TIKTOK_CLIENT_SECRET=

# ── Publishing safety ─────────────────────────────────────────────────
# Max posts per account per day (browser + API adapters both enforce).
MAX_POSTS_PER_ACCOUNT_PER_DAY=10

# ── Local storage paths (defaults match the compose volume mounts) ────
MEDIA_CACHE_DIR=./media_cache
BROWSER_PROFILES_DIR=./browser_profiles
CHECKPOINT_DB=checkpoints.db

# ⚠ Browser automation may violate some platforms' Terms of Service.
# Use only with your own accounts. See docs/setup.md before going live.
