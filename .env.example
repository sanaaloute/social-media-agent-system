# ── Core ──────────────────────────────────────────────────────────────
# Local dev default is SQLite; compose overrides with Postgres.
DATABASE_URL=sqlite:///./dev.db
# Optional. When unset, an in-memory fallback is used for cache/rate limits.
REDIS_URL=
# eager = run tasks inline (no Redis needed, local dev); celery = real queue.
QUEUE_MODE=eager
# Global dry-run: publishers simulate success instead of calling live APIs.
DRY_RUN=true

# ── Generation providers (local models by default — no fakes) ─────────
LLM_PROVIDER=ollama          # ollama | openrouter | claude | openai
IMAGE_PROVIDER=local         # local | kie | dalle | stable_diffusion
VIDEO_PROVIDER=local         # local | kie | falai | kling

ANTHROPIC_API_KEY=
OPENAI_API_KEY=
# Local LLMs (dev/test on this machine's GPU)
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_MODEL=qwen2.5:7b
# Hosted gateways — one key each instead of per-type vendors
OPENROUTER_API_KEY=
OPENROUTER_MODEL=openai/gpt-4o-mini
KIE_API_KEY=
KIE_IMAGE_MODEL=gpt-image-1.5
KIE_VIDEO_MODEL=veo3.1
STABILITY_API_KEY=
FAL_KEY=
KLING_API_KEY=

# Local diffusion image/video on this machine's GPU (optional):
#   pip install -r requirements-local.txt
# then set IMAGE_PROVIDER=local and/or VIDEO_PROVIDER=local.
LOCAL_IMAGE_MODEL=Tongyi-MAI/Z-Image-Turbo
LOCAL_VIDEO_MODEL=Wan-AI/Wan2.1-T2V-1.3B-Diffusers
# Target seconds for local clips; >5s chains ~5s segments (~4 min GPU each
# on a 16GB card — a 60s clip is ~45 min). Also editable in Settings.
LOCAL_VIDEO_SECONDS=2

# LLM resilience: when the primary LLM provider fails, fall back to this one.
LLM_FALLBACK_PROVIDER=

# Autopilot (fully autonomous mode): master switch (default OFF) and the
# minimum hours between auto-generated tasks per brand. Per-brand opt-in
# is on the settings page.
AUTOPILOT_ENABLED=false
AUTOPILOT_INTERVAL_HOURS=6

# ── Network (only if your network blocks Google News / HuggingFace) ────
# Outbound proxy for web research + downloads; NO_PROXY keeps local
# services (Ollama) direct. Alternatively use the HF mirror for model
# downloads: HF_ENDPOINT=https://hf-mirror.com
HTTP_PROXY=
NO_PROXY=localhost,127.0.0.1
#HF_ENDPOINT=https://hf-mirror.com

# ── Security ──────────────────────────────────────────────────────────
# AES-256 key, base64url-encoded 32 bytes. Generate with:
#   python -c "from cryptography.fernet import Fernet; import base64,os; print(base64.urlsafe_b64encode(os.urandom(32)).decode())"
ENCRYPTION_KEY=

# ── Platform API credentials (optional; dry-run works without them) ───
META_APP_ID=
META_APP_SECRET=
LINKEDIN_CLIENT_ID=
LINKEDIN_CLIENT_SECRET=
YOUTUBE_CLIENT_ID=
YOUTUBE_CLIENT_SECRET=
TWITTER_CLIENT_ID=
TWITTER_CLIENT_SECRET=
TIKTOK_CLIENT_KEY=
TIKTOK_CLIENT_SECRET=

# ── Publishing safety ─────────────────────────────────────────────────
# Max posts per account per day (browser + API adapters both enforce).
MAX_POSTS_PER_ACCOUNT_PER_DAY=10

# ── Local storage paths (defaults match the compose volume mounts) ────
MEDIA_CACHE_DIR=./media_cache
BROWSER_PROFILES_DIR=./browser_profiles
CHECKPOINT_DB=checkpoints.db

# ⚠ Browser automation may violate some platforms' Terms of Service.
# Use only with your own accounts. See docs/setup.md before going live.
